# `connect-src` whitelists `api.github.com` so the inline release
# resolver in index.html can hit `/repos/erdembas/runhq/releases/latest`
# at page load and rewrite the download anchors to the versioned
# bundle URLs. That endpoint already serves
# `Access-Control-Allow-Origin: *`, so no proxy is needed — but CSP
# `connect-src` is the second gate and was defaulting to `'self'`,
# which silently blocked the fetch ("Refused to connect because it
# violates the document's CSP"). Keeping the allowlist tight: only
# the JSON releases endpoint, no `*.githubusercontent.com` — the
# resolver only reads metadata, and the actual download navigation
# happens via top-level `<a href>` clicks which CSP doesn't gate.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.github.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# NOTE: `immutable` is ONLY safe on fingerprinted URLs (e.g. style-abc123.css).
# Our docs site uses stable filenames — if we keep `immutable` + 1y TTL on
# `/style.css`, any CSS change strands users on whatever Cloudflare edge
# cached the previous version, sometimes for hours (different edges expire
# at different times). Root cause of the "hero-maas class works locally but
# not on CF Pages" bug: AMS edge was serving 2h-old CSS while DUS edge had
# the fresh one.
#
# Short TTL + stale-while-revalidate keeps the perf win (edge serves stale
# instantly on the next hit and refreshes in background) without the
# deploy-and-pray tax. If/when we fingerprint assets, flip back to immutable.
/*.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400, must-revalidate

/*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/
  Cache-Control: public, max-age=300, must-revalidate
